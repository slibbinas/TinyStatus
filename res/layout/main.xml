<?xml version="1.0" encoding="utf-8"?>
<!--
  Apvalus 438x438 ekranas. Vienas pagrindinis vaizdas (ziedas + tekstas) ir du
  langai virs jo: nustatymai (nust) ir IP ivedimas (ipl), abu "gone", kol
  neatidaryti. Langai - ne atskiros veiklos: taip Back ir braukimas atgal
  lieka musu rankose (Vallox pamoka).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg">

    <FrameLayout
        android:id="@+id/ekranas"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <lt.vsid.tinystatus.RingView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          VISOS eilutes viename vertikaliame sraute ir su FIKSUOTOMIS
          aukstinemis. Du dalykai is to seka, ir abu svarbus:

          1. Persidengti eilutes negali fiziskai - nebera nei "prilipdytu prie
             virsaus" elementu, nei besikeiciancio aukscio nuo teksto ilgio.
          2. Kiekvienos eilutes vertikali padetis ZINOMA is anksto, tad
             MainActivity.sutalpink() gali APSKAICIUOTI, koks plotis toje
             aukstumoje telpa i apskritima, ir nustatyti sonines parastes.
             Anksciau jos buvo parenkamos is akies, ir tekstas vis lisdavo po
             ziedu (V, 2026-09-10: "sudelioti NE IS ATMINTIES, o paskaiciavus").

          Eiliskumas (V): svarbiausia - kiek liko laiko, tad tai didysis
          skaicius; sluoksniai smulkiai virsuje, nes i klausima "kiek toli"
          jau atsako ziedas.
        -->
        <LinearLayout
            android:id="@+id/stulpelis"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp">

            <!-- Spausdintuvo vardas - tik kai ju keli. -->
            <TextView
                android:id="@+id/printer"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="11sp"
                android:textColor="@color/brand_blue_light"
                android:visibility="gone" />
            <TextView
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textColor="@color/brand_blue_light"
                android:text="@string/dash" />
            <TextView
                android:id="@+id/didelis"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textSize="26sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="15sp"
                android:autoSizeMaxTextSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/brand_text"
                android:text="@string/connecting" />
            <TextView
                android:id="@+id/state"
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:textSize="14sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeMaxTextSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_latte"
                android:text="" />
            <TextView
                android:id="@+id/layer"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textColor="@color/brand_latte"
                android:text="@string/dash" />
            <TextView
                android:id="@+id/resin"
                android:layout_width="match_parent"
                android:layout_height="17dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="12sp"
                android:textColor="@color/brand_latte"
                android:text="@string/dash" />
            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="9sp"
                android:textColor="@color/brand_faint"
                android:text="" />
            <!-- Braukimas AUKSTYN atnaujina, ir tai turi MATYTIS: uzklausos
                 metu rodykle sukasi ir pasviesėja (V). -->
            <ImageView
                android:id="@+id/refresh"
                android:layout_width="15dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ts_refresh"
                android:tint="@color/brand_faint"
                android:contentDescription="@string/tap_hint" />
        </LinearLayout>

        <!--
          NUSTATYMU PUSLAPIS (V, 2026-09-12 - tas pats sprendimas kaip ValloxWatch):
          aktyvus nustatymai vienu zvilgsniu, bakstelejus - redagavimo langas.
          Iki tol i nustatymus vede tik ilgas paspaudimas, o jo niekas nerasdavo.
          Eilutes dedamos kodu (MainActivity.pieskNustPuslapi).
        -->
        <LinearLayout
            android:id="@+id/psl_nust"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="6dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:text="@string/t_settings" />

            <LinearLayout
                android:id="@+id/psl_eilutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:textColor="@color/brand_latte"
                android:text="@string/t_tap_open" />
        </LinearLayout>

        <!-- Puslapiu taskai: spausdintuvai, paskutinis - nustatymai. -->
        <TextView
            android:id="@+id/taskai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:includeFontPadding="false"
            android:textSize="8sp"
            android:textColor="@color/brand_faint" />
    </FrameLayout>

    <!-- ============================================================ NUSTATYMAI -->
    <ScrollView
        android:id="@+id/nust"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_bg"
        android:paddingLeft="26dp"
        android:paddingRight="28dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="26dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:layout_marginBottom="4dp"
                android:text="@string/t_printer" />

            <LinearLayout
                android:id="@+id/auto_eilute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/auto_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/brand_muted"
                android:text="@string/auto_on" />

            <!-- Spausdintuvu sarasas (tik kai autodiscovery isjungtas). -->
            <LinearLayout
                android:id="@+id/printers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/t_background" />

            <TextView
                android:id="@+id/bg_off"
                style="@style/Mygtukas"
                android:text="@string/bg_off" />
            <TextView
                android:id="@+id/bg_const"
                style="@style/Mygtukas"
                android:text="@string/bg_const" />
            <TextView
                android:id="@+id/bg_2"
                style="@style/Mygtukas"
                android:text="@string/bg_2" />
            <TextView
                android:id="@+id/bg_5"
                style="@style/Mygtukas"
                android:text="@string/bg_5" />
            <TextView
                android:id="@+id/bg_10"
                style="@style/Mygtukas"
                android:text="@string/bg_10" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/brand_muted"
                android:text="@string/bg_hint" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/t_alerts" />

            <!-- Jungikliu eilutes dedamos kodu (perjungiklis): vardas atskirai
                 nuo jungiklio, kitaip Switch nukerpa teksta. -->
            <LinearLayout
                android:id="@+id/alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/t_app" />

            <TextView
                android:id="@+id/upd_check"
                style="@style/Mygtukas"
                android:text="@string/a_update" />

            <!-- Versija, o patikrinus - ka rado (TsAtnaujink). -->
            <TextView
                android:id="@+id/upd_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:textSize="10sp"
                android:textColor="@color/brand_muted" />

            <TextView
                android:id="@+id/n_close"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/veiksmas"
                android:textSize="13sp"
                android:textColor="@color/on_blue"
                android:text="@string/a_close" />
        </LinearLayout>
    </ScrollView>

    <!-- ============================================================ IP LANGAS -->
    <!--
      Atskiras langas, ne eilute nustatymuose: ivedant reikia klaviaturos, o ji
      uzdengia puse ekrano. Keturi langeliai, ne vienas laukas su tasku:
      inputType="number" taska atmeta, o ilgas adresas netilpo (Vallox).
    -->
    <ScrollView
        android:id="@+id/ipl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_bg"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_blue_light"
                android:layout_marginBottom="10dp"
                android:text="@string/t_ip" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/k_ip1"
                    style="@style/IpLaukas"
                    android:imeOptions="actionNext" />
                <TextView style="@style/IpTaskas" />
                <EditText
                    android:id="@+id/k_ip2"
                    style="@style/IpLaukas"
                    android:imeOptions="actionNext" />
                <TextView style="@style/IpTaskas" />
                <EditText
                    android:id="@+id/k_ip3"
                    style="@style/IpLaukas"
                    android:imeOptions="actionNext" />
                <TextView style="@style/IpTaskas" />
                <EditText
                    android:id="@+id/k_ip4"
                    style="@style/IpLaukas"
                    android:imeOptions="actionDone" />
            </LinearLayout>

            <TextView
                android:id="@+id/k_irasyk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/veiksmas"
                android:textSize="13sp"
                android:textColor="@color/on_blue"
                android:text="@string/a_save" />

            <TextView
                android:id="@+id/k_busena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:minHeight="14dp"
                android:textSize="11sp"
                android:textColor="@color/brand_muted" />

            <TextView
                android:id="@+id/k_isimk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/mygtukas"
                android:textSize="13sp"
                android:textColor="@color/brand_text"
                android:text="@string/a_remove" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
