<?xml version="1.0" encoding="utf-8"?>
<!--
  PASIRINKIMO mygtukas: aktyvus - firmine TinyMaker zydra (logotipo Wi-Fi
  lanko spalva), neaktyvus - firmine antrinio mygtuko pilkuma. Pilka sako
  "sitas ne", zydra - "sitas dabar" (Vallox pamoka: penki vienodo atspalvio
  mygtukai verčia pasirinkima ieskoti).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_pale" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_button" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
