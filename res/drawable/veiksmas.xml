<?xml version="1.0" encoding="utf-8"?>
<!--
  VEIKSMO mygtukas (Save, Add printer, Close) ir ivedimo laukai. Atskiras nuo
  mygtukas.xml todel, kad cia nera nei "aktyvus", nei "neaktyvus" - veiksmas
  visada prieinamas, ir su pasirinkimo spalvomis jis nuolat atrodytu isjungtas.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_light" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
